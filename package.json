{
  "name": "sereness-match",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "tsc --noEmit && vite build --config vite.admin.config.ts",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "cap:sync": "npm run build && cap sync",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:pages": "npm run typecheck && vite build --mode pages --base=/sereness-match/ --outDir ../dist-pages --emptyOutDir",
    "test:browser": "node tests/browser.mjs",
    "build:online-preview": "vite build --mode online-preview --outDir ../dist-online --emptyOutDir"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.16.0",
    "globals": "^16.5.0",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.0.0"
  }
}
